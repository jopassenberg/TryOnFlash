{
  // Cloudflare Worker: serves the static app from public/, mirrors the depth model under /hf/*
  // and stores encrypted flash links (/api/share, viewer at /f/:id). Needs the KV namespace SHARES.
  "name": "tryonflash",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "SHARES", "id": "5ad3019a6f4e4090807a4a16637efced" }], // stencit-shares
  // Bremse gegen Missbrauch: höchstens 10 neue Teilen-Links (bzw. Vorschauen) pro Minute und IP-Adresse
  "ratelimits": [{ "name": "SHARE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "workers_dev": true,
  "preview_urls": true
}
