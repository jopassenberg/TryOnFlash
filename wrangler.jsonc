{
  // Cloudflare Worker: serves the static app from public/ and mirrors the depth model under /hf/*.
  "name": "tryonflash",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/hf/*"] },
  "workers_dev": true,
  "preview_urls": true
}
